@page "/"
@using DCMotorControlApp.Services
@using System.ComponentModel
@inject IMotorBluetoothService BluetoothService
@implements IDisposable

<div class="motor-dashboard">
    <h3 class="dashboard-title">مشروع التحكم بالمحرك</h3>

    <div class="panel connection-panel">
        <div class="status-indicator">
            @if (BluetoothService.IsConnecting)
            {
                <span class="dot connecting"></span>
                <span class="status-text">يتصل بـ  @BluetoothService.ConnectingDeviceName...</span>
            }
            else if (BluetoothService.IsConnected)
            {
                <span class="dot online"></span>
                <span class="status-text">متصل بـ @BluetoothService.ConnectingDeviceName</span>
            }
            else
            {
                <span class="dot offline"></span>
                <span class="status-text">غير متصل</span>
            }
        </div>

        @if (!BluetoothService.IsConnected && !BluetoothService.IsConnecting)
        {
            <button class="btn btn-scan" @onclick="ScanDevices" disabled="@BluetoothService.IsScanning">
                @(BluetoothService.IsScanning ? "جاري البحث..." : "البحث عن ESP32")
            </button>

            @if (BluetoothService.DiscoveredDeviceNames.Any())
            {
                <div class="device-list">
                    @foreach (var device in BluetoothService.DiscoveredDeviceNames)
                    {
                        <div class="device-item" @onclick="() => ConnectToDevice(device)">
                            📱 @device <span class="connect-link">اتصال</span>
                        </div>
                    }
                </div>
            }
        }
        else if (BluetoothService.IsConnected)
        {
            <button class="btn btn-disconnect" @onclick="DisconnectDevice">الغاء الاتصال</button>
        }
    </div>

    <div class="panel control-panel @(BluetoothService.IsConnected ? "" : "disabled-panel")">
        
        <div class="section-title">Direction System</div>
        <div class="direction-grid">
            <button class="btn btn-dir btn-forward" @onclick='() => SendDirection("F")'>Forward</button>
            <button class="btn btn-dir btn-stop" @onclick='() => SendDirection("S")'>STOP 🛑</button>
            <button class="btn btn-dir btn-backward" @onclick='() => SendDirection("B")'>Backward</button>
        </div>

        <div class="section-title" style="margin-top: 25px;">اختر السرعة (PWM)</div>
        <div class="speed-grid">
            <button class="btn btn-speed" @onclick='() => SendSpeed("1")'>10%</button>
            <button class="btn btn-speed" @onclick='() => SendSpeed("3")'>30%</button>
            <button class="btn btn-speed" @onclick='() => SendSpeed("6")'>60%</button>
            <button class="btn btn-speed" @onclick='() => SendSpeed("9")'>90%</button>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // ربط أحداث تغيير الخصائص لتحديث الواجهة تلقائياً عند العثور على أجهزة
        BluetoothService.PropertyChanged += OnServicePropertyChanged;
    }

    private async Task ScanDevices()
    {
        await BluetoothService.StartScanningAsync();
    }

    private async Task ConnectToDevice(string name)
    {
        await BluetoothService.ConnectToDeviceAsync(name);
    }

    private async Task DisconnectDevice()
    {
        await BluetoothService.DisconnectAsync();
    }

    private async Task SendDirection(string dirCode)
    {
        await BluetoothService.SendCommandAsync(dirCode);
    }

    private async Task SendSpeed(string speedCode)
    {
        await BluetoothService.SendCommandAsync(speedCode);
    }

    private void OnServicePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BluetoothService.PropertyChanged -= OnServicePropertyChanged;
    }
}